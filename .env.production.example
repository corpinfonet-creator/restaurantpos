# =============================================================================
#  PLANTILLA PARA PRODUCCIÓN (cPanel)
#
#  Copiar como .env en el servidor y rellenar los valores marcados con <>.
#  El .env NUNCA se sube al repositorio ni se deja dentro de public_html.
# =============================================================================

APP_NAME="Sistema Restaurante"
APP_ENV=production
APP_KEY=<pegar aquí la clave: php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<tudominio.com>

# --- Logs -------------------------------------------------------------------
# 'daily' rota por día y conserva 14 ficheros: evita el laravel.log de cientos
# de MB que crece sin límite con 'single'.
# 'error' descarta el ruido de debug/info: en producción solo interesan fallos.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# --- Base de datos ----------------------------------------------------------
# cPanel prefija los nombres con la cuenta: cuenta_restaurante, cuenta_usuario.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<cuenta>_restaurante
DB_USERNAME=<cuenta>_usuario
DB_PASSWORD=<contraseña>

# --- Sesión -----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Cookies solo por HTTPS. Requiere certificado SSL activo (AutoSSL en cPanel).
# Si se pone en true sin HTTPS, nadie podrá iniciar sesión.
SESSION_SECURE_COOKIE=true

# La cookie no es accesible desde JavaScript: limita el robo de sesión por XSS.
SESSION_HTTP_ONLY=true

# Bloquea el envío de la cookie en peticiones de otros sitios (anti-CSRF).
SESSION_SAME_SITE=lax

# --- Caché ------------------------------------------------------------------
# 'file' es más rápido que 'database' en hosting compartido: la caché de
# ajustes se resuelve leyendo un fichero local en vez de consultando MySQL.
CACHE_STORE=file

# --- Colas ------------------------------------------------------------------
# 'sync' ejecuta en la misma petición. En cPanel normalmente no hay un worker
# permanente, así que es la opción segura: nada queda encolado sin procesar.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo -----------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=<smtp.tudominio.com>
MAIL_PORT=465
MAIL_USERNAME=<correo@tudominio.com>
MAIL_PASSWORD=<contraseña>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="<correo@tudominio.com>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
