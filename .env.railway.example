# =============================================================================
#  VARIABLES DE ENTORNO PARA RAILWAY
#
#  Estas NO van en un archivo: se pegan en el servicio, pestaña "Variables".
#  Railway las inyecta en el entorno del contenedor.
# =============================================================================

APP_NAME="Sistema Restaurante"
APP_ENV=production
APP_DEBUG=false

# Generar en local con:  php artisan key:generate --show
# y pegar el valor completo, incluido el prefijo base64:
APP_KEY=

# El dominio que asigna Railway, o el propio si conectas uno.
# Debe incluir https:// y NO llevar barra final.
APP_URL=https://tuapp.up.railway.app

# --- Base de datos ----------------------------------------------------------
# Al añadir MySQL al proyecto, Railway expone estas variables. Se referencian
# así para que sigan funcionando si la base se recrea:
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# --- Sesión -----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Railway sirve todo por HTTPS. Requiere el trustProxies de bootstrap/app.php,
# que ya está configurado: sin él la cookie se marca 'secure', Laravel no ve
# HTTPS detrás del proxy, y nadie puede iniciar sesión.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Caché ------------------------------------------------------------------
# 'file' evita una consulta a MySQL por cada acierto de caché. Los ajustes del
# sistema (nombre, logo, moneda, zona horaria) se sirven desde aquí.
CACHE_STORE=file

# --- Colas ------------------------------------------------------------------
# 'sync' ejecuta en la misma petición: no hace falta un worker aparte.
QUEUE_CONNECTION=sync

# --- Logs -------------------------------------------------------------------
# 'stderr' es lo correcto en contenedores: los logs van a la consola de
# Railway en vez de a un archivo que se borra en cada despliegue.
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Zona horaria -----------------------------------------------------------
# No se define aquí a propósito: config/app.php tiene 'UTC' fijo y no lee esta
# variable. La zona horaria real se configura desde la pantalla de Ajustes del
# sistema y el middleware SetTimezone la aplica en cada petición.

# --- Licencia ---------------------------------------------------------------
# Sin la clave pública el sistema no puede verificar el token y queda
# bloqueado. Los saltos de línea se escriben literalmente como \n.
LICENCIA_SERVIDOR=
LICENCIA_PUBLIC_KEY=

FILESYSTEM_DISK=local
